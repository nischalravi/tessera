# Rendered at container start by the nginx image's envsubst step (only ${API_UPSTREAM} is substituted).
# API_UPSTREAM is host:port of the Tessera API, for example api:8000 (Compose), tessera-api:8000
# (Kubernetes Service) or 127.0.0.1:8000 (a sidecar in the same task or pod).
#
# Paths below mirror mvp/frontend/vite.config.ts, the dev proxy. Keep them in step.

upstream tessera_api {
  server ${API_UPSTREAM};
  keepalive 16;
}

# Forwarded headers. The API trusts X-Forwarded-For only from peers listed in TESSERA_TRUSTED_PROXIES:
# list this container's network (and any load balancer in front of it).
map $http_x_forwarded_proto $tessera_proto {
  default $http_x_forwarded_proto;
  ""      $scheme;
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Security headers are added on the static locations only: the API sets its own on proxied responses.

  # Load balancer and kubelet health check of the UI container itself.
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # API and the public/guest, OAuth, MCP and well-known endpoints.
  location /api/ { include /etc/nginx/tessera-proxy.inc; }
  location /public/t/ { include /etc/nginx/tessera-proxy.inc; }
  location /.well-known/ { include /etc/nginx/tessera-proxy.inc; }
  location ~ ^/t/[a-z0-9-]+/(bootstrap|oauth/.*|\.well-known/.*)$ { include /etc/nginx/tessera-proxy.inc; }
  location ~ ^/t/[a-z0-9-]+/mcp/(oauth|\.well-known)/ { include /etc/nginx/tessera-proxy.inc; }

  # Hashed build assets: cache forever.
  location /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Content-Type-Options nosniff always;
  }

  # Single-page app: every other path is a client-side route.
  location / {
    try_files $uri /index.html;
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
  }
}
