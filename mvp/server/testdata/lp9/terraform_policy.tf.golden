# Tessera right-sizing suggestion 11111111-1111-4111-8111-111111111111: the policy below keeps what was used in the last 120 days and drops 3 unused permission(s) (evidence confidence: high).
# Replace the policy document of your own resource for this policy with it, review the plan, and apply it yourself.
# Policy: arn:aws:iam::111111111111:policy/team/App-Read
resource "aws_iam_policy" "App_Read" {
  name   = "App-Read"
  path   = "/team/"
  policy = <<-POLICY
    {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "s3:GetObject"
          ],
          "Resource": "arn:aws:s3:::team-$${aws:username}/*"
        }
      ]
    }
  POLICY
}
