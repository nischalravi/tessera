      "description": "Deployment health"
     }
    },
    "parameters": [
     {
      "name": "X-Tessera-User",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 120
      }
     }
    ]
   }
  },
  "/api/connections/{id}/readiness/evidence": {
   "get": {
    "summary": "Evidence export (ZIP) of one connection",
    "description": "Permission: connections.read and audit.read. Returns manifest.json (SHA-256 of every file, template pins, ledger sequence range and chain head, control mapping), checklist.csv, checks.csv, findings.csv (sample object ids only), skipped.csv and score.json. Records readiness.evidence.exported with the manifest hash.",
    "responses": {
     "200": {
      "description": "application/zip"
     },
     "403": {
      "description": "audit.read is missing"
     },
     "404": {
      "description": "No such connection"
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "X-Tessera-User",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 120
      }
     }
    ]
   }
  },
  "/api/insights/deployment-health/evidence": {
   "get": {
    "summary": "Evidence export (ZIP) of every connection of the tenant",
    "description": "Permission: connections.read and audit.read. Same files as the connection export, with one row per connection. Records readiness.evidence.exported with the manifest hash.",
    "responses": {
     "200": {
      "description": "application/zip"
     },
     "403": {
      "description": "audit.read is missing"
     }
    },
    "parameters": [
     {
      "name": "X-Tessera-User",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 120
      }
     }
    ]
   }
  },
  "/api/insights/deployment-health/rerun": {
   "post": {
    "summary": "Re-run live checks (and optionally reconciliation) for all connections",
    "description": "Permission: connections.manage",
    "responses": {
     "200": {
      "description": "Rerun summary"
     }
    },
    "parameters": [
     {
      "name": "X-Tessera-User",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 120
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Rerun"
       }
      }
     }
    }
   }
  },
  "/api/connections/{id}/containment-credential": {
   "put": {
    "summary": "Write-only provider credential for the kill switch (Okta, Entra, Google, GitHub); sealed at rest, never returned",
    "description": "Permission: connections.manage + step-up (issue #106). Body: token, base_url (required for Okta), org (required for GitHub).",
    "responses": {
     "200": {
      "description": "{configured: true}"
     },
     "422": {
      "description": "invalid_credential"
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "token": {
          "type": "string",
          "maxLength": 8192
         },
         "base_url": {
          "type": "string",
          "maxLength": 512
         },
         "org": {
          "type": "string",
          "maxLength": 100
         }
        },
        "required": [
         "token"
        ],
        "additionalProperties": false
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "ConnConfig": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "host": {
      "type": "string"
     },
     "user_filter": {
      "type": "string"
     },
     "group_filter": {
      "type": "string"
     },
     "org_url": {
      "type": "string"
     },
     "tenant_id": {
      "type": "string"
     },
     "cloud": {
      "type": "string"
     },
     "customer": {
      "type": "string"
     },
     "domain": {
      "type": "string"
     },
     "base_url": {
      "type": "string"
     },
     "tenant_host": {
      "type": "string"
     },
     "api_version": {
      "type": "string"
     },
     "interface": {
      "type": "string"
     },
     "time_zone": {
      "type": "string"
     },
     "correlation_key": {
      "type": "string"
     },
     "hr_id_attribute": {
      "type": "string"
     },
     "technical_owner": {
      "type": "string"
     },
     "business_owner": {
      "type": "string"
     },
     "sync_schedule": {
      "type": "string"
     },
     "bind_dn": {
      "type": "string"
     },
     "ca_bundle": {
      "type": "string"
     },
     "port": {
      "enum": [
       389,
       636
      ]
     },
     "base_dns": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "service_account_ous": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "stale_days": {
      "type": "integer"
     },
     "write_mode": {
      "enum": [
       "off",
       "dry_run",
       "scoped"
      ]
     },
     "write_scope": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "hybrid": {
      "type": "boolean"
     },
     "use_dirsync": {
      "type": "boolean"
     },
     "expected_counts": {
      "type": "object",
      "properties": {
       "users": {
        "type": "integer"
       },
       "groups": {
        "type": "integer"
       }
      }
     },
     "privileged_expected": {
      "type": "object",
      "additionalProperties": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     "demo_fixed_checks": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "Demo connectors only: simulated checks that pass"
     },
     "settings": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      },
      "description": "Non-secret options of the governed connector types (awsorg, githubscan, sap, oracle, cyberark, beyondtrust, delinea, fieldglass, beeline, csvfeed, agentcore, successfactors, azurerbac, gcpiam, unixssh, mcp, bedrock); the keys each type takes are closed (username, client_id, org, snapshot, regions, external_id, api_root, token_path, workers_path, csv_path, page_size, role_name, account_ids, management_account_id, identity_center_region, tenant_id, subscription_ids, management_group_ids, include_eligible, organization_id, folder_ids, project_ids, host, port, host_key, use_sudo). The secret is the sealed credential."
     }
    },
    "description": "Typed, secret-free connection configuration. Unknown fields are rejected."
   },
   "Overlay": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "add_items": {
      "type": "array",
      "items": {
       "type": "object"
      }
     },
     "raise_levels": {
      "type": "object",
      "additionalProperties": {
       "enum": [
        "required",
        "recommended",
        "optional"
       ]
      }
     },
     "thresholds": {
      "type": "object",
      "additionalProperties": {
       "type": "number"
      }
     },
     "remove_items": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "Always rejected (level_downgrade_forbidden)"
     },
     "disable_items": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "Always rejected (level_downgrade_forbidden)"
     }
    }
   },
   "CreateConnection": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "name",
     "connector_type"
    ],
    "properties": {
     "name": {
      "type": "string",
      "maxLength": 100
     },
     "connector_type": {
      "type": "string",
      "examples": [
       "demo-ad",
       "demo-okta",
       "demo-workday",
       "ad",
       "ldap",
       "entra",
       "okta",
       "google",
       "workday",
       "scim_app",
       "awsorg",
       "githubscan",
       "sap",
       "oracle",
       "cyberark",
       "beyondtrust",
       "delinea",
       "fieldglass",
       "beeline",
       "csvfeed",
       "agentcore",
       "successfactors",
       "azurerbac",
       "gcpiam",
       "unixssh",
       "mcp",
       "bedrock"
      ]
     },
     "system": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
     },
     "role": {
      "enum": [
       "authoritative",
       "account_source"
      ]
     },
     "config": {
      "$ref": "#/components/schemas/ConnConfig"
     }
    }
   },
   "Credential": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "secret": {
      "type": "string",
      "writeOnly": true,
      "maxLength": 8192
     },
     "reference": {
      "type": "string",
      "pattern": "^(vault|agent):[A-Za-z0-9._/:@-]{1,200}$"
     }
    }
   },
   "Attest": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "note"
    ],
    "properties": {
     "note": {
      "type": "string",
      "minLength": 10
     }
    }
   },
   "AttestInstead": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "attester",
     "reason",
     "evidence"
    ],
    "properties": {
     "attester": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
     },
     "reason": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
     },
     "evidence": {
      "type": "string",
      "minLength": 10,
      "maxLength": 4000
     }
    }
   },
   "Skip": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "reason"
    ],
    "properties": {
     "reason": {
      "type": "string",
      "minLength": 20
     },
     "review_by": {
      "type": "string",
      "format": "date"
     }
    }
   },
   "Transition": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "to"
    ],
    "properties": {
     "to": {
      "enum": [
       "ready_to_validate",
       "dry_run_reconciled"
      ]
     }
    }
   },
   "Retire": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "confirm"
    ],
    "properties": {
     "confirm": {
      "const": true
     }
    }
   },
   "Accept": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "reason"
    ],
    "properties": {
     "reason": {
      "type": "string",
      "minLength": 20
     },
     "expires_at": {
      "type": "string",
      "format": "date"
     }
    }
   },
   "Rerun": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "reconcile": {
      "type": "boolean"
     }
    }
   }
  }
 }
}