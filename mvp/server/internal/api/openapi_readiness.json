       "type": "string"
      }
     },
     {
      "name": "X-Tessera-User",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 120
      }
     }
    ]
   }
  },
  "/api/connections/{id}/findings": {
   "get": {
    "summary": "Findings; filter by run, code, severity, status",
