{
 "openapi": "3.1.0",
 "info": {
  "title": "Tessera deployment readiness",
  "version": "0.1.0",
  "description": "Deployment readiness API (docs/design/deployment-readiness.md \u00a79). Every route needs a signed-in session; the permission each route needs is listed with it (step-up means a phishing-resistant sign-in in the last 15 minutes, otherwise 401 step_up_required). Errors are {\"error\": code, \"detail\": message}; refused transitions return the gate report {error, state, to, blocking: [{item|finding, level|severity, status, reason}]}."
 },
 "paths": {
  "/api/readiness/templates": {
   "get": {
    "summary": "List readiness templates",
    "description": "Permission: connections.read",
    "responses": {
     "200": {
      "description": "Template summaries with item counts per level"
     }
    },
    "parameters": [
     {
      "name": "X-Tessera-User",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 120
      }
     }
    ]
   }
  },
  "/api/readiness/templates/{type}": {
   "get": {
    "summary": "Template after the tenant overlay",
    "description": "Permission: connections.read",
    "responses": {
     "200": {
      "description": "Resolved template"
     },
     "404": {
      "description": "Unknown template"
     }
    },
    "parameters": [
     {
      "name": "type",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "X-Tessera-User",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 120
      }
     }
    ]
   }
  },
  "/api/readiness/overlays/{type}": {
   "put": {
    "summary": "Add items, raise levels, tighten thresholds",
    "description": "Permission: connections.manage + step-up (DR-10)",
    "responses": {
     "200": {
      "description": "Template with the overlay applied"
     },
     "422": {
      "description": "level_downgrade_forbidden or invalid_overlay"
     }
    },
    "parameters": [
     {
      "name": "type",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "X-Tessera-User",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 120
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Overlay"
       }
      }
     }
    }
   }
  },
  "/api/connections": {
   "get": {
    "summary": "Governed connections plus legacy (TESSERA_CONNECTORS) connectors",
    "description": "Permission: connections.read",
    "responses": {
     "200": {
      "description": "Connections"
     }
    },
    "parameters": [
     {
      "name": "X-Tessera-User",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 120
      }
     }
    ]
   },
   "post": {
    "summary": "Create a connection in draft",
    "description": "Permission: connections.manage",
    "responses": {
     "201": {
      "description": "Connection"
     },
     "409": {
      "description": "duplicate_connection"
     },
     "422": {
      "description": "unknown_connector_type, invalid_config"
     }
    },
    "parameters": [
     {
      "name": "X-Tessera-User",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 120
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CreateConnection"
       }
      }
     }
    }
   }
  },
  "/api/connections/{id}": {
   "get": {
    "summary": "Connection with its live and in-progress revisions",
    "description": "Permission: connections.read",
    "responses": {
     "200": {
      "description": "Connection"
     },
     "404": {
      "description": "not_found"
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "X-Tessera-User",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 120
      }
     }
    ]
   }
  },
  "/api/connections/{id}/config": {
   "patch": {
    "summary": "Edit the in-progress revision (creates one when active); returns invalidated items",
    "description": "Permission: connections.manage + step-up (DR-10)",
    "responses": {
     "200": {
      "description": "{connection, new_revision, invalidated, fields}"
     },
     "422": {
      "description": "invalid_config"
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "X-Tessera-User",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 120
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ConnConfig"
       }
      }
     }
    }
   }
  },
  "/api/connections/{id}/credential": {
   "put": {
    "summary": "Write-only credential or vault/agent reference; never returned",
    "description": "Permission: connections.manage + step-up (DR-10)",
    "responses": {
     "200": {
      "description": "{present, kind, version}"
     },
     "422": {
      "description": "invalid_credential"
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "X-Tessera-User",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 120
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Credential"
       }
      }
     }
    }
   }
  },
  "/api/connections/{id}/checklist": {
   "get": {
    "summary": "Items with level, status, verification, dependencies and blockers",
    "description": "Permission: connections.read",
    "responses": {
     "200": {
      "description": "Checklist"
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "X-Tessera-User",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 120
      }
     }
    ]
   }
  },
  "/api/connections/{id}/checklist/{item}/attest": {
   "post": {
    "summary": "Attest an item with a note (at least 10 characters)",
    "description": "Permission: connections.manage",
    "responses": {
     "200": {
      "description": "Checklist"
     },
     "409": {
      "description": "dependencies_not_passing (gate report)"
     },
     "422": {
      "description": "note_too_short, not_attestable"
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "item",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "X-Tessera-User",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 120
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Attest"
       }
      }
     }
    }
   }
  },
  "/api/connections/{id}/checklist/{item}/attest-instead": {
   "post": {
    "summary": "Attest in place of a live check the system reports unsupported",
    "description": "Permission: connections.manage; step-up required. Only items whose template declares on_unsupported: attestation, and only while the latest live result is unsupported (a failed result cannot be attested).",
    "responses": {
     "200": {
      "description": "Checklist"
     },
     "409": {
      "description": "dependencies_not_passing (gate report)"
     },
     "422": {
      "description": "attester_required, reason_too_short, evidence_required, not_attestable_instead, live_check_not_unsupported"
     },
     "401": {
      "description": "step_up_required"
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "item",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "X-Tessera-User",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 120
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/AttestInstead"
       }
      }
     }
    }
   }
  },
  "/api/connections/{id}/checklist/{item}/skip": {
   "post": {
    "summary": "Skip a Recommended item with a reason (at least 20 characters)",
    "description": "Permission: connections.manage",
    "responses": {
     "200": {
      "description": "Checklist"
     },
     "422": {
      "description": "required_item_not_skippable, reason_too_short"
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "item",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "X-Tessera-User",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 120
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Skip"
       }
      }
     }
    }
   },
   "delete": {
    "summary": "Un-skip",
    "description": "Permission: connections.manage",
    "responses": {
     "200": {
      "description": "Checklist"
     },
     "404": {
      "description": "not skipped"
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "item",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "X-Tessera-User",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 120
      }
     }
    ]
   }
  },
  "/api/connections/{id}/transition": {
   "post": {
    "summary": "Move to ready_to_validate or dry_run_reconciled",
    "description": "Permission: connections.manage",
    "responses": {
     "200": {
      "description": "Connection"
     },
     "409": {
      "description": "transition_blocked (gate report)"
     },
     "422": {
      "description": "invalid_target"
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "X-Tessera-User",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 120
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Transition"
       }
      }
     }
    }
   }
  },
  "/api/connections/{id}/activate": {
   "post": {
    "summary": "Re-evaluate every gate and activate",
    "description": "Permission: connections.activate + step-up. A read-only revision (write_mode off) is activated at once; a write-enabled one opens an activation request that a different person approves (two-person rule)",
    "responses": {
     "200": {
      "description": "Connection (write_mode off)"
     },
     "202": {
      "description": "pending_approval: an activation request waits for a second person (write_mode dry_run or scoped)"
     },
     "409": {
      "description": "activation_blocked (gate report)"
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "X-Tessera-User",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 120
      }
     }
    ]
   }
  },
  "/api/connections/{id}/activation": {
   "get": {
    "summary": "The connection's latest activation request (two-person activation)",
    "description": "Permission: connections.read",
    "responses": {
     "200": {
      "description": "{request: null | {id, revision_id, write_mode, status, requested_by, requested_at, expires_at, decided_by, decided_at, decision_note}}"
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ]
   }
  },
  "/api/connections/{id}/activation/approve": {
   "post": {
    "summary": "Approve the open activation request and apply the activation",
    "description": "Permission: connections.activate + step-up. The approver must differ from the requester and must not have attested an item of the revision; the gate is evaluated again and the revision must be unchanged since the request",
    "requestBody": {
     "required": false,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "note": {
          "type": "string",
          "maxLength": 500
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Connection (now active)"
     },
     "403": {
      "description": "two_person_rule (requester or attestor), or interactive_authentication_required"
     },
     "409": {
      "description": "no_activation_request, activation_request_stale, activation_request_expired or activation_blocked (gate report)"
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ]
   }
  },
  "/api/connections/{id}/activation/reject": {
   "post": {
    "summary": "Reject (or, by the requester, cancel) the open activation request",
    "description": "Permission: connections.activate",
    "requestBody": {
     "required": false,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "note": {
          "type": "string",
          "maxLength": 500
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "{request}"
     },
     "409": {
      "description": "no_activation_request"
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ]
   }
  },
  "/api/connections/{id}/retire": {
   "post": {
    "summary": "Retire the connection",
    "description": "Permission: connections.manage + step-up (DR-10)",
    "responses": {
     "200": {
      "description": "Connection"
     },
     "422": {
      "description": "confirmation_required"
     }
    },
    "parameters": [
