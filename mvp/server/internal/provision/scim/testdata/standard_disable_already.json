{
 "name": "Standard SCIM: user already inactive, no PATCH",
 "interactions": [
  {
   "request": {
    "method": "GET",
    "path": "/Users",
    "query": {
     "filter": "userName eq \"alice@larkspur.example\""
    }
   },
   "response": {
    "status": 200,
    "headers": {
     "Content-Type": "application/scim+json"
    },
    "body": {
     "schemas": [
      "urn:ietf:params:scim:api:messages:2.0:ListResponse"
     ],
     "totalResults": 1,
     "startIndex": 1,
     "itemsPerPage": 1,
     "Resources": [
      {
       "schemas": [
        "urn:ietf:params:scim:schemas:core:2.0:User"
       ],
       "id": "u-1",
       "userName": "alice@larkspur.example",
       "displayName": "Alice Park",
       "active": "false"
      }
     ]
    }
   }
  }
 ]
}