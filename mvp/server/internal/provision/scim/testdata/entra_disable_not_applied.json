{
 "name": "Entra: PATCH acknowledged, re-read still active",
 "interactions": [
  {
   "request": {
    "method": "GET",
    "path": "/Users",
    "query": {
     "filter": "userName eq \"alice@larkspur.example\""
    }
   },
   "response": {
    "status": 200,
    "headers": {
     "Content-Type": "application/scim+json"
    },
